{
  "name": "quest-log-actions",
  "private": true,
  "type": "module",
  "description": "The Quest Log GitHub Action: validates, sends push notifications and reads photos for a Quest Log data repo.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:reader": "cd reader && python3 -m unittest test_rules",
    "fixtures": "node scripts/run-fixtures.mjs"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@anthropic-ai/sdk": "^1.6.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
